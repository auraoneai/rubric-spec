{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auraone.ai/schemas/rubric-schema-v1.json",
  "title": "AuraOne Rubric Schema v1",
  "type": "object",
  "required": [
    "version",
    "rubric_id",
    "criteria",
    "judge_prompt_contract",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "auraone-rubric-v1"
    },
    "rubric_id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "tie_break_rule": {
      "type": "string",
      "enum": [
        "prefer_lower_risk",
        "prefer_higher_score",
        "manual_review",
        "none"
      ]
    },
    "judge_prompt_contract": {
      "type": "object",
      "required": [
        "instruction",
        "output_format"
      ],
      "properties": {
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "output_format": {
          "type": "string",
          "enum": [
            "json",
            "score",
            "label"
          ]
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "created_by",
        "created_at",
        "synthetic"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "criterion_id",
          "label",
          "scale_type",
          "weight",
          "anchors"
        ],
        "additionalProperties": true,
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "scale_type": {
            "type": "string",
            "enum": [
              "binary",
              "ordinal",
              "likert",
              "continuous"
            ]
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "tie_break_rule": {
            "type": "string",
            "enum": [
              "prefer_lower_risk",
              "prefer_higher_score",
              "manual_review",
              "none"
            ]
          },
          "anchors": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "value",
                "label"
              ],
              "properties": {
                "value": {},
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
